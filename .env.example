# ===========================================
# PR Guardian AI — Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# GitHub App Configuration
GITHUB_APP_ID=your_app_id
GITHUB_PRIVATE_KEY_PATH=./keys/github-app.pem
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# LLM Provider API Keys (at least one required)
HF_TOKEN=your_huggingface_token
HF_API_URL=https://router.huggingface.co/v1/chat/completions
OPENAI_API_KEY=
GROQ_API_KEY=your_groq_key
GEMINI_API_KEY=your_gemini_key
CEREBRAS_API_KEY=your_cerebras_key
OPENROUTER_API_KEY=your_openrouter_key

# CORS — comma-separated allowed origins (leave empty to allow all)
CORS_ORIGINS=

# Logging
LOG_LEVEL=info

# MongoDB — use Atlas connection string for production
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/pr_reviewer
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=pr_reviewer
